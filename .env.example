# Скопируй этот файл в .env и заполни значения
# cp .env.example .env

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=emotion_diary

# Neo4j
NEO4J_AUTH=neo4j/your_neo4j_password
NEO4J_PASSWORD=your_neo4j_password

# Node API
JWT_SECRET=your_random_secret_here
DATABASE_URL=postgres://postgres:your_postgres_password@postgres:5432/emotion_diary

# HuggingFace (нужен только если модель приватная; для Aniemore можно оставить пустым)
HF_TOKEN=
